# LF everywhere; the Windows launchers need CRLF (the release zip is built on Linux)
* text=auto eol=lf
*.bat text eol=crlf
*.vbs text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.glb binary
*.bin binary
*.exr binary
*.mp4 binary
*.wav binary
*.ogg binary
# vendored libraries stay byte for byte as published (test/sri.test.mjs checks their hash)
src/vendor/** -text
