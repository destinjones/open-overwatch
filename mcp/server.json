  "version": "0.4.1",
  "websiteUrl": "https://destinjones.github.io/open-overwatch/",
  "repository": { "url": "https://github.com/destinjones/open-overwatch", "source": "github" },
  "icons": [
    { "src": "https://destinjones.github.io/open-overwatch/brand/emblem/emblem-256.png", "mimeType": "image/png", "sizes": ["256x256"] }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "open-overwatch-mcp",
      "version": "0.4.1",
