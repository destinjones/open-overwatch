{
  "name": "open-overwatch-mcp",
  "version": "0.4.2",
  "mcpName": "io.github.destinjones/open-overwatch",
  "description": "Ask Claude about the live Earth: earthquakes, satellites and when to see them, launches, storms, ships, weather, the aurora and tonight's sky, from public open data. Every answer carries a link that opens the live 3D globe there, and Claude Desktop shows the globe in the chat.",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "mcp-apps", "claude", "globe", "satellites", "earthquakes", "weather", "aurora", "astronomy", "night-sky", "space", "open-data", "osint"],
  "homepage": "https://destinjones.github.io/open-overwatch/",
  "repository": { "type": "git", "url": "git+https://github.com/destinjones/open-overwatch.git" },
  "bugs": { "url": "https://github.com/destinjones/open-overwatch/issues" },
  "license": "MIT",
  "author": { "name": "Destin Jones", "url": "https://github.com/destinjones" },
  "bin": { "open-overwatch-mcp": "mcp/server.mjs" },
  "files": [
    "mcp/*.mjs", "!mcp/worker.mjs", "mcp/README.md", "NOTICE", "src/package.json",
    "src/core/actype.js", "src/core/airports.js", "src/core/ais.js", "src/core/assets.js", "src/core/bikes.js", "src/core/borders.js",
    "src/core/cables.js", "src/core/cameras.js", "src/core/campose.js", "src/core/clouds.js", "src/core/comets.js", "src/core/craft.js",
    "src/core/crew.js", "src/core/cyclones.js", "src/core/darksky.js", "src/core/decay.js", "src/core/deepsky.js", "src/core/eclipse.js",
    "src/core/eclipselocal.js", "src/core/eonet.js", "src/core/eta.js", "src/core/explain.js", "src/core/fireclusters.js", "src/core/format.js",
    "src/core/geo.js", "src/core/gfs.js", "src/core/gtfsrt.js", "src/core/hazards.js", "src/core/kepler.js", "src/core/launches.js",
    "src/core/lightpollution.js", "src/core/liveprov.js", "src/core/measure.js", "src/core/metar.js", "src/core/meteors.js", "src/core/moons.js",
    "src/core/mvt.js", "src/core/observer.js", "src/core/ocean.js", "src/core/osmtiles.js", "src/core/passes.js", "src/core/planets.js",
    "src/core/provenance.js", "src/core/quakes.js", "src/core/runways.js", "src/core/search.js", "src/core/sky.js", "src/core/skyplace.js",
    "src/core/smallbodies.js", "src/core/solarlink.js", "src/core/solarsys.js", "src/core/spaceweather.js", "src/core/time.js", "src/core/tle.js",
    "src/core/traffic.js", "src/core/transit.js", "src/core/transitfeeds.js", "src/core/units.js", "src/core/viewlink.js", "src/core/voicecmd.js",
    "src/core/whereis.js", "src/core/wxpoint.js"
  ],
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": { "satellite.js": "5.0.0" },
  "devDependencies": { "@playwright/test": "1.64.1", "@types/node": "22.20.5", "eslint": "10.13.0", "globals": "17.13.0", "typescript": "6.0.3" },
  "scripts": { "mcp": "node mcp/server.mjs", "test": "node --test", "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/core/**\" --test-coverage-include=\"mcp/**\" --test-coverage-lines=96 --test-coverage-branches=83 --test-coverage-functions=91", "e2e": "playwright test", "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.workers.json", "lint": "eslint src mcp test e2e brand/tools relay sw.js serve.js playwright.config.mjs eslint.config.mjs" }
}
