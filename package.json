{
  "name": "open-overwatch-mcp",
  "version": "0.3.0",
  "description": "Ask Claude about the live Earth: earthquakes, satellites and when to see them, launches, storms, ships, weather, the aurora and tonight's sky, from public open data. Every answer carries a link that opens the live 3D globe there, and Claude Desktop shows the globe in the chat.",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "mcp-apps", "claude", "globe", "satellites", "earthquakes", "open-data", "osint"],
  "homepage": "https://destinjones.github.io/open-overwatch/",
  "repository": { "type": "git", "url": "git+https://github.com/destinjones/open-overwatch.git" },
  "bugs": "https://github.com/destinjones/open-overwatch/issues",
  "license": "MIT",
  "author": "Destin Jones",
  "bin": { "open-overwatch-mcp": "mcp/server.mjs" },
  "files": ["mcp/*.mjs", "mcp/README.md", "src/package.json", "src/core/"],
  "engines": { "node": ">=20" },
  "dependencies": { "satellite.js": "5.0.0" },
  "devDependencies": { "@playwright/test": "1.63.0" },
  "scripts": { "mcp": "node mcp/server.mjs", "test": "node --test", "e2e": "playwright test" }
}
